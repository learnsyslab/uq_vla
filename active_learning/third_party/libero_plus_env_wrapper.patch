+def _motion_blur_np(x, radius, sigma, angle):
+    """Line-kernel motion blur (cf. imagecorruptions._motion_blur): a 1-D gaussian of the given radius/sigma
+    laid along `angle`, applied with cv2.filter2D. x: HxWx3 uint8 -> uint8."""
+    width = int(radius * 2 + 1)
+    k = np.arange(width) - radius
+    k = np.exp(-(k ** 2) / (2 * sigma ** 2)); k = k / k.sum()
+    kernel = np.zeros((width, width), dtype=np.float32); kernel[width // 2, :] = k
+    M = cv2.getRotationMatrix2D((width / 2 - 0.5, width / 2 - 0.5), float(angle), 1.0)
+    kernel = cv2.warpAffine(kernel, M, (width, width)); kernel = kernel / max(kernel.sum(), 1e-8)
+    return np.clip(cv2.filter2D(np.asarray(x, dtype=np.float32), -1, kernel), 0, 255).astype(np.uint8)

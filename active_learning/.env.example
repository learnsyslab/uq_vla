# Copy to .env (read by the scripts and by the iterative fine-tuning configs' paths.env_file).
# Where Hugging Face downloads models and datasets; LeRobot datasets go to $HF_HOME/lerobot/<repo_id>.
HF_HOME=${HOME}/.cache/huggingface
# Headless MuJoCo rendering for LIBERO.
MUJOCO_GL=egl
PYOPENGL_PLATFORM=egl
# Weights & Biases logging is off in every config; set WANDB_MODE=online and pass --wandb.enable=true to use it.
WANDB_MODE=offline
